{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pwnedpasswordsblobworker",
  "main": "index.ts",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2026-07-23",
  "workers_dev": false,
  "secrets": {
    "required": [
      "AZURE_STORAGE_ACCOUNT",
      "AZURE_CLIENT_ID",
      "AZURE_TENANT_ID",
      "SHA1_BLOB_CONTAINER",
      "NTLM_BLOB_CONTAINER",
      "AZURE_CLIENT_SECRET"
    ]
  },
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "env": {
    "stage": {
      "name": "pwnedpasswordsblobworkerstage",
      "workers_dev": false,
      "secrets": {
        "required": [
          "AZURE_STORAGE_ACCOUNT",
          "AZURE_CLIENT_ID",
          "AZURE_TENANT_ID",
          "SHA1_BLOB_CONTAINER",
          "NTLM_BLOB_CONTAINER",
          "AZURE_CLIENT_SECRET"
        ]
      }
    },
    "prod": {
      "name": "pwnedpasswordsblobworker",
      "workers_dev": false,
      "secrets": {
        "required": [
          "AZURE_STORAGE_ACCOUNT",
          "AZURE_CLIENT_ID",
          "AZURE_TENANT_ID",
          "SHA1_BLOB_CONTAINER",
          "NTLM_BLOB_CONTAINER",
          "AZURE_CLIENT_SECRET"
        ]
      }
    }
  },
  "placement": {
    "mode": "smart"
  }
}
