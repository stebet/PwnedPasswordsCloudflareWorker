{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "pwnedpasswordsworker",
  "main": "index.ts",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2026-07-23",
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "env": {
    "stage": {
      "name": "pwnedpasswordsworkerstage",
      "routes": ["stage-api.pwnedpasswords.com/*"],
      "secrets": {
        "required": [
          "AZURE_STORAGE_ACCOUNT",
          "AZURE_CLIENT_ID",
          "AZURE_TENANT_ID",
          "SHA1_BLOB_CONTAINER",
          "NTLM_BLOB_CONTAINER",
          "AZURE_CLIENT_SECRET",
          "HIBP_PURGE_CACHE_SECRET"
        ]
      },
      "services": [
        { "binding": "BLOB_ENTRYPOINT", "service": "pwnedpasswordsworkerstage", "entrypoint": "BlobEntrypoint" },
        { "binding": "PURGE_ENTRYPOINT", "service": "pwnedpasswordsworkerstage", "entrypoint": "PurgeEntrypoint" },
        { "binding": "RANGE_ENTRYPOINT", "service": "pwnedpasswordsworkerstage" }
      ]
    },
    "prod": {
      "name": "pwnedpasswordsworkerprod",
      "routes": ["api.pwnedpasswords.com/range/*", "api.pwnedpasswords.com/purge*"],
      "secrets": {
        "required": [
          "AZURE_STORAGE_ACCOUNT",
          "AZURE_CLIENT_ID",
          "AZURE_TENANT_ID",
          "SHA1_BLOB_CONTAINER",
          "NTLM_BLOB_CONTAINER",
          "AZURE_CLIENT_SECRET",
          "HIBP_PURGE_CACHE_SECRET"
        ]
      },
      "services": [
        { "binding": "BLOB_ENTRYPOINT", "service": "pwnedpasswordsworkerprod", "entrypoint": "BlobEntrypoint" },
        { "binding": "PURGE_ENTRYPOINT", "service": "pwnedpasswordsworkerprod", "entrypoint": "PurgeEntrypoint" },
        { "binding": "RANGE_ENTRYPOINT", "service": "pwnedpasswordsworkerprod" }
      ]
    }
  },
  "placement": {
    "mode": "smart"
  }
}
