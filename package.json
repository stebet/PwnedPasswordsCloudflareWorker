{
  "private": true,
  "name": "pwnedpasswordsworker",
  "version": "1.0.0",
  "description": "A worker for api.pwnedpasswords.com to help with caching and padding.",
  "main": "index.js",
  "type": "module",
  "author": "Troy Hunt <troy@troyhunt.com>",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@types/node": "26.2.0",
    "@vitest/coverage-istanbul": "4.1.11",
    "@vitest/runner": "4.1.11",
    "@vitest/snapshot": "4.1.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  },
  "scripts": {
    "dev": "wrangler dev --config src/range-worker/wrangler.jsonc --env stage --env-file .dev.vars",
    "start": "pnpm dev",
    "build": "pnpm run build:api",
    "build:api": "wrangler deploy --dry-run --config src/range-worker/wrangler.jsonc --env stage",
    "deploy": "pnpm run deploy:api",
    "deploy:api": "wrangler deploy --config src/range-worker/wrangler.jsonc --env stage",
    "deploy:prod": "pnpm run deploy:api:prod",
    "deploy:api:prod": "wrangler deploy --config src/range-worker/wrangler.jsonc --env prod",
    "typecheck": "tsc --noEmit --project src/range-worker/tsconfig.json",
    "types": "wrangler types src/range-worker/worker-configuration.d.ts --config src/range-worker/wrangler.jsonc --env stage --env-interface ApiEnv --strict-vars false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "packageManager": "pnpm@11.22.0"
}
